# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Database (Postgres) ---
# Local dev: the Docker Postgres from docker-compose (see README).
# Production (Vercel Postgres): set DATABASE_URL to the POOLED url and
# DIRECT_URL to the NON-POOLING url from the Vercel Storage dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Auth ---
# Signs the session cookie. Generate: `openssl rand -base64 32`
AUTH_SECRET="change-me"

# --- AI editor (optional) ---
# Left OFF by default → deterministic mock editor (no API spend).
# Set to "true" only to use the real Claude proxy for edits.
USE_REAL_AI="false"
# Buoyant hiring proxy token (only used when USE_REAL_AI=true).
BUOYANT_PROXY_TOKEN=""
