# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude settings (permission allowlist stays local)
.claude/settings.local.json

# parse cache
.cache/

# take-home source materials — kept LOCAL for dev, never published to the public repo
# (Buoyant's brief + MECO's real proposals; scrubbed from history too)
/docs/take-home-assessment.md
/docs/requirements.md
/docs/ExampleProposals/
/docs/_analysis/
/docs/TakeHomeExampleProposals.zip

# playwright (artifacts; screenshots render MECO content so keep them local)
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/screenshots/

!.env.example
